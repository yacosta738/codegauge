{
  "release-type": "rust",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "extra-files": [
    "README.md",
    "tests/golden/valid-methods.json",
    "crates/codegauge-model/tests/contracts.rs",
    "crates/codegauge-cli/tests/cli.rs"
  ],
  "packages": {
    "crates/codegauge-model": { "component": "codegauge-model", "release-type": "rust" },
    "crates/codegauge-core": { "component": "codegauge-core", "release-type": "rust" },
    "crates/codegauge-application": { "component": "codegauge-application", "release-type": "rust" },
    "crates/codegauge-provider-jacoco": { "component": "codegauge-provider-jacoco", "release-type": "rust" },
    "crates/codegauge-cli": { "component": "codegauge-cli", "release-type": "rust" },
    "npm/codegauge": {
      "component": "codegauge",
      "release-type": "node",
      "package-name": "@yacosta738/codegauge",
      "extra-files": [
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.optionalDependencies['@yacosta738/codegauge-linux-x64-gnu']" },
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.optionalDependencies['@yacosta738/codegauge-linux-arm64-gnu']" },
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.optionalDependencies['@yacosta738/codegauge-darwin-x64']" },
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.optionalDependencies['@yacosta738/codegauge-darwin-arm64']" },
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.optionalDependencies['@yacosta738/codegauge-win32-x64-msvc']" },
        { "type": "json", "path": "npm/codegauge/package.json", "jsonpath": "$.optionalDependencies['@yacosta738/codegauge-win32-arm64-msvc']" }
      ]
    },
    "npm/packages/codegauge-linux-x64-gnu": { "component": "codegauge-linux-x64-gnu", "release-type": "node" },
    "npm/packages/codegauge-linux-arm64-gnu": { "component": "codegauge-linux-arm64-gnu", "release-type": "node" },
    "npm/packages/codegauge-darwin-x64": { "component": "codegauge-darwin-x64", "release-type": "node" },
    "npm/packages/codegauge-darwin-arm64": { "component": "codegauge-darwin-arm64", "release-type": "node" },
    "npm/packages/codegauge-win32-x64-msvc": { "component": "codegauge-win32-x64-msvc", "release-type": "node" },
    "npm/packages/codegauge-win32-arm64-msvc": { "component": "codegauge-win32-arm64-msvc", "release-type": "node" }
  },
  "plugins": [
    { "type": "cargo-workspace", "merge": false },
    {
      "type": "linked-versions",
      "groupName": "codegauge runtime graph",
      "components": [
        "codegauge-model",
        "codegauge-core",
        "codegauge-application",
        "codegauge-provider-jacoco",
        "codegauge-cli",
        "codegauge",
        "codegauge-linux-x64-gnu",
        "codegauge-linux-arm64-gnu",
        "codegauge-darwin-x64",
        "codegauge-darwin-arm64",
        "codegauge-win32-x64-msvc",
        "codegauge-win32-arm64-msvc"
      ]
    }
  ]
}

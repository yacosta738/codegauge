{
  "release-type": "rust",
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "skip-github-release": true,
  "packages": {
    ".": {
      "component": "codegauge-root",
      "release-type": "java",
      "initial-version": "0.1.0",
      "skip-github-release": true,
      "skip-changelog": true,
      "skip-snapshot": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == \"codegauge-model\" || @.name.value == \"codegauge-core\" || @.name.value == \"codegauge-application\" || @.name.value == \"codegauge-provider-jacoco\" || @.name.value == \"codegauge-cli\")].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-core/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-model\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-application/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-core\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-application/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-model\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-provider-jacoco/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-application\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-provider-jacoco/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-model\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-cli/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-application\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-cli/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-model\"].version"
        },
        {
          "type": "toml",
          "path": "/crates/codegauge-cli/Cargo.toml",
          "jsonpath": "$.dependencies[\"codegauge-provider-jacoco\"].version"
        },
        { "type": "generic", "path": "/README.md" },
        { "type": "generic", "path": "/tests/golden/valid-methods.json" },
        { "type": "generic", "path": "/crates/codegauge-model/tests/contracts.rs" },
        { "type": "generic", "path": "/crates/codegauge-cli/tests/cli.rs" }
      ]
    },
    "crates/codegauge-model": { "component": "codegauge-model", "release-type": "rust" },
    "crates/codegauge-core": { "component": "codegauge-core", "release-type": "rust" },
    "crates/codegauge-application": { "component": "codegauge-application", "release-type": "rust" },
    "crates/codegauge-provider-jacoco": { "component": "codegauge-provider-jacoco", "release-type": "rust" },
    "crates/codegauge-cli": { "component": "codegauge-cli", "release-type": "rust" },
    "npm/codegauge": {
      "component": "codegauge",
      "release-type": "node",
      "package-name": "@yacosta738/codegauge",
      "extra-files": [
        { "type": "json", "path": "package.json", "jsonpath": "$.version" }
      ]
    },
    "npm/packages/codegauge-linux-x64-gnu": { "component": "codegauge-linux-x64-gnu", "release-type": "node" },
    "npm/packages/codegauge-linux-arm64-gnu": { "component": "codegauge-linux-arm64-gnu", "release-type": "node" },
    "npm/packages/codegauge-darwin-x64": { "component": "codegauge-darwin-x64", "release-type": "node" },
    "npm/packages/codegauge-darwin-arm64": { "component": "codegauge-darwin-arm64", "release-type": "node" },
    "npm/packages/codegauge-win32-x64-msvc": { "component": "codegauge-win32-x64-msvc", "release-type": "node" },
    "npm/packages/codegauge-win32-arm64-msvc": { "component": "codegauge-win32-arm64-msvc", "release-type": "node" }
  },
  "plugins": [
    { "type": "node-workspace", "merge": false },
    {
      "type": "linked-versions",
      "groupName": "codegauge runtime graph",
      "components": [
        "codegauge-root",
        "codegauge-model",
        "codegauge-core",
        "codegauge-application",
        "codegauge-provider-jacoco",
        "codegauge-cli",
        "codegauge",
        "codegauge-linux-x64-gnu",
        "codegauge-linux-arm64-gnu",
        "codegauge-darwin-x64",
        "codegauge-darwin-arm64",
        "codegauge-win32-x64-msvc",
        "codegauge-win32-arm64-msvc"
      ]
    }
  ]
}
